<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- BrowserRecoveryHTTPServer binds loopback listeners for held responses.
         Preserve Xcode's runner sandbox; grant this only to the UI-test target. -->
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>
