# Local verbs forward to cmux-tui (session "cloud"). `cmux vm …` talks to peers
# this machine was linked to from the Mac (`cmux vm link <src> <dst>`).
set -eu

case "${1:-}:${2:-}" in
  self:*|vm:ls|vm:list)
